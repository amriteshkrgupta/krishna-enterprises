# Server Configuration
PORT=5000
NODE_ENV=development

# Firebase Project
FIREBASE_PROJECT_ID=krishna-enterprises-77254

# Firebase Admin SDK Service Account
# Option 1 (recommended for local dev): download serviceAccountKey.json from
#   Firebase Console > Project Settings > Service Accounts > Generate new private key
#   Then set: GOOGLE_APPLICATION_CREDENTIALS=./config/serviceAccountKey.json
#
# Option 2 (for Render/Railway/Cloud): paste the entire JSON as a single line:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

GOOGLE_APPLICATION_CREDENTIALS=./config/serviceAccountKey.json

# Image Storage (optional - S3 or local /uploads used automatically)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=krishna-enterprises-images

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
